{
  "name": "@rootkey/mcp",
  "version": "0.1.1",
  "description": "Official ROOTKey MCP server - operate vaults, files, records and recovery points from Claude",
  "license": "MIT",
  "author": "ROOTKey <support@rootkey.ai> (https://rootkey.ai)",
  "homepage": "https://docs.rootkey.ai/pages/integrations/claude-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ROOT-Key/rootkey-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ROOT-Key/rootkey-mcp/issues"
  },
  "keywords": [
    "rootkey",
    "mcp",
    "modelcontextprotocol",
    "claude",
    "blockchain",
    "file-integrity",
    "compliance",
    "nis2",
    "dora"
  ],
  "type": "module",
  "bin": {
    "rootkey-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
